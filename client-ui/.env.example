# Client UI (Vite) — public values only; never put secrets here.
# Docker Compose injects these from the repo-root .env.
# For Vite outside Compose, copy to client-ui/.env

# API base URL (must include /api)
VITE_API_BASE_URL=http://localhost:8000/api

# Dev server listen port (must match CORS / CSRF / CLIENT_UI_ORIGIN on the backend)
CLIENT_UI_PORT=5173
