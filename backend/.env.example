# Backend (Django) — copy to backend/.env for non-Compose runs.
# Docker Compose still loads the repo-root .env into this service.
# Keep keys in sync with the root .env.example.

# Django
SECRET_KEY=change-me-in-development
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (DATABASE_HOST=postgres inside Compose / k8s; localhost if DB on host)
DATABASE_NAME=researchhub
DATABASE_USER=researchhub
DATABASE_PASSWORD=changeme
DATABASE_HOST=postgres
DATABASE_PORT=5432

# CORS / CSRF — keep in sync with client-ui / admin-ui ports
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5175
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:5175

# Admin-only API routes — must match admin-ui Origin
ADMIN_UI_ORIGINS=http://localhost:5175

# Email (console for local; override in private .env for SMTP)
CLIENT_UI_ORIGIN=http://localhost:5173
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=ResearchHub <noreply@example.com>
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Auth rate limits (django-ratelimit; per client IP)
AUTH_RATE_LIMIT=5/m
PASSWORD_RESET_RATE_LIMIT=2/m

# Optional later (cloud docs) — unused by local Compose / Docker Desktop k8s
PUBLIC_DOMAIN=localhost
