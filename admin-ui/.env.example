# Admin UI (Vite) — public values only; never put secrets here.
# Docker Compose injects these from the repo-root .env; for local Vite, copy to admin-ui/.env
# Backend ADMIN_UI_ORIGINS must include this app's Origin (e.g. http://localhost:5175).

# API base URL (must include /api)
VITE_API_BASE_URL=http://localhost:8000/api

# Dev server listen port (must match ADMIN_UI_ORIGINS on the backend)
ADMIN_UI_PORT=5175
