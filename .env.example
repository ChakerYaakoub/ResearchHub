# Django
SECRET_KEY=change-me-in-development
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DATABASE_NAME=researchhub
DATABASE_USER=researchhub
DATABASE_PASSWORD=changeme
DATABASE_HOST=postgres
DATABASE_PORT=5432

# CORS / frontend origin (local)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Frontend (Vite) — public values only, no secrets
VITE_API_BASE_URL=http://localhost:8000/api

# Email (Django + SMTP)
# Local/dev: console backend (no real SMTP required)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=ResearchHub <noreply@example.com>
# Production SMTP:
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Production (Google Cloud + DuckDNS + HTTPS)
PUBLIC_DOMAIN=localhost
# DuckDNS token (production only; leave empty locally)
DUCKDNS_TOKEN=
# CSRF / trusted origins when behind HTTPS (comma-separated)
CSRF_TRUSTED_ORIGINS=http://localhost:5173
