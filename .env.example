# ResearchHub — root env for Docker Compose (and reference for local k8s ConfigMap/Secret).
# Copy to `.env` at the repo root (gitignored). Compose loads this for all services.
#
# Per-app copies (optional, for non-Compose runs):
#   backend/.env.example  → backend/.env
#   client-ui/.env.example → client-ui/.env
#   admin-ui/.env.example  → admin-ui/.env
#
# Local Kubernetes: non-secrets → k8s/configmap.yaml ; secrets → k8s/secret.example.yaml
# Never put real passwords in *.example files or git.

# =============================================================================
# Backend (Django)
# =============================================================================
SECRET_KEY=change-me-in-development
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# =============================================================================
# PostgreSQL
# DATABASE_HOST=postgres inside Compose / k8s service name
# =============================================================================
DATABASE_NAME=researchhub
DATABASE_USER=researchhub
DATABASE_PASSWORD=changeme
DATABASE_HOST=postgres
DATABASE_PORT=5432

# =============================================================================
# Host ports (Compose publish + Vite listen)
# Keep CORS / CSRF / ADMIN_UI_ORIGINS / CLIENT_UI_ORIGIN in sync with these ports
# =============================================================================
BACKEND_PORT=8000
CLIENT_UI_PORT=5173
ADMIN_UI_PORT=5175

# =============================================================================
# CORS / CSRF / admin Origin allowlist
# =============================================================================
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5175
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:5175
ADMIN_UI_ORIGINS=http://localhost:5175

# Absolute client-ui origin for invitation email links (no trailing slash)
CLIENT_UI_ORIGIN=http://localhost:5173

# =============================================================================
# Frontends (Vite) — public values only; never put secrets here
# Must include /api
# =============================================================================
VITE_API_BASE_URL=http://localhost:8000/api

# =============================================================================
# Email (Django)
# Local default: console (prints to backend logs). For real SMTP, set smtp backend
# and fill HOST_USER / HOST_PASSWORD in your private .env only.
# =============================================================================
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=ResearchHub <noreply@example.com>
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# =============================================================================
# Auth rate limits (django-ratelimit; per client IP)
# Format: "<count>/<unit>" where unit is s, m, h, or d
# =============================================================================
AUTH_RATE_LIMIT=5/m
PASSWORD_RESET_RATE_LIMIT=2/m

# =============================================================================
# Optional later (cloud deploy docs) — unused by Compose / local Docker Desktop k8s
# =============================================================================
PUBLIC_DOMAIN=localhost
