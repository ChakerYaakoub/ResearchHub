# ResearchHub — Docker Compose / full-stack local env
# Copy to `.env` at the repo root (gitignored). Compose loads this for all services.
#
# Per-project reference (same keys, scoped comments):
#   backend/.env.example
#   client-ui/.env.example
#   admin-ui/.env.example

# --- Backend (Django) ---
SECRET_KEY=change-me-in-development
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL ---
DATABASE_NAME=researchhub
DATABASE_USER=researchhub
DATABASE_PASSWORD=changeme
DATABASE_HOST=postgres
DATABASE_PORT=5432

# --- Service ports (Compose publish + Vite listen) ---
BACKEND_PORT=8000
CLIENT_UI_PORT=5173
ADMIN_UI_PORT=5175

# --- CORS / UI origins — keep in sync with CLIENT_UI_PORT / ADMIN_UI_PORT ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5175
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:5175

# Admin-only API routes (stats, approve/reject) must come from these Origins
ADMIN_UI_ORIGINS=http://localhost:5175

# --- Frontends (Vite) — public values only, no secrets ---
VITE_API_BASE_URL=http://localhost:8000/api

# --- Email (Django + SMTP) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=ResearchHub <noreply@example.com>
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# --- Production (Google Cloud + DuckDNS + HTTPS) ---
PUBLIC_DOMAIN=localhost
DUCKDNS_TOKEN=
